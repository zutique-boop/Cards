{
  "sections": {
    "image_banner": {
      "type": "image-banner",
      "blocks": {
        "heading": {
          "type": "heading",
          "settings": {
            "heading": "Tarjetas ilustradas para los momentos que importan",
            "heading_size": "h0"
          }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "Piezas únicas de ilustradores del mundo, curadas en Argentina.",
            "text_style": "subtitle"
          }
        },
        "button": {
          "type": "buttons",
          "settings": {
            "button_label_1": "Ver colección",
            "button_link_1": "shopify://collections/all",
            "button_style_secondary_1": false,
            "button_label_2": "Conocé a los artistas",
            "button_link_2": "shopify://pages/artistas",
            "button_style_secondary_2": true
          }
        }
      },
      "block_order": ["heading", "text", "button"],
      "settings": {
        "image_overlay_opacity": 20,
        "image_height": "large",
        "desktop_content_position": "middle-center",
        "show_text_box": true,
        "desktop_content_alignment": "center",
        "color_scheme": "scheme-1",
        "mobile_content_alignment": "center",
        "stack_images_on_mobile": false,
        "show_text_below": false
      }
    },
    "rich_text": {
      "type": "rich-text",
      "blocks": {
        "heading": {
          "type": "heading",
          "settings": { "heading": "Cada tarjeta, una pequeña obra de arte", "heading_size": "h1" }
        },
        "text": {
          "type": "text",
          "settings": { "text": "<p>En Estampa seleccionamos tarjetas ilustradas de editoriales independientes de Europa, Japón y Latinoamérica. Papel de calidad, impresiones cuidadas y diseños que merecen guardarse.</p>" }
        },
        "button": {
          "type": "button",
          "settings": { "button_label": "Nuestra historia", "button_link": "shopify://pages/sobre-nosotros", "button_style_secondary": true }
        }
      },
      "block_order": ["heading", "text", "button"],
      "settings": { "color_scheme": "scheme-2", "full_width": true, "padding_top": 60, "padding_bottom": 60 }
    },
    "featured_collection": {
      "type": "featured-collection",
      "settings": {
        "title": "Más queridas del mes",
        "heading_size": "h2",
        "description": "Las tarjetas que más están viajando a nuevas casas.",
        "collection": "all",
        "products_to_show": 8,
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "show_view_all": true,
        "view_all_style": "link",
        "swipe_on_mobile": true,
        "image_ratio": "portrait",
        "show_secondary_image": true,
        "show_vendor": true,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 48,
        "padding_bottom": 48
      }
    },
    "collage": {
      "type": "collage",
      "blocks": {
        "collection-0": { "type": "collection", "settings": { "collection": "cumpleanos" } },
        "collection-1": { "type": "collection", "settings": { "collection": "amor" } },
        "collection-2": { "type": "collection", "settings": { "collection": "nacimiento" } }
      },
      "block_order": ["collection-0", "collection-1", "collection-2"],
      "settings": {
        "heading": "Elegí por ocasión",
        "heading_size": "h2",
        "desktop_layout": "left",
        "mobile_layout": "collage",
        "color_scheme": "scheme-1",
        "padding_top": 48,
        "padding_bottom": 48
      }
    },
    "multicolumn": {
      "type": "multicolumn",
      "blocks": {
        "column1": { "type": "column", "settings": { "title": "Envíos a todo el país", "text": "<p>Despachamos por Correo Argentino y Andreani. Retiro gratis en Palermo (CABA).</p>", "link_label": "", "link": "" } },
        "column2": { "type": "column", "settings": { "title": "Pagá como quieras", "text": "<p>MercadoPago con todas las tarjetas, hasta 12 cuotas. También aceptamos transferencia bancaria con 10% off.</p>", "link_label": "", "link": "" } },
        "column3": { "type": "column", "settings": { "title": "Empaque de regalo", "text": "<p>Cada pedido viaja en sobre ilustrado con sello en lacre. Sumá una dedicatoria escrita a mano sin costo.</p>", "link_label": "", "link": "" } }
      },
      "block_order": ["column1", "column2", "column3"],
      "settings": {
        "title": "Pensado con detalle",
        "heading_size": "h2",
        "image_width": "third",
        "image_ratio": "adapt",
        "columns_desktop": 3,
        "column_alignment": "center",
        "background_style": "primary",
        "button_label": "",
        "button_link": "",
        "swipe_on_mobile": false,
        "color_scheme": "scheme-2",
        "columns_mobile": "1",
        "padding_top": 48,
        "padding_bottom": 48
      }
    },
    "newsletter": {
      "type": "newsletter",
      "blocks": {
        "heading": { "type": "heading", "settings": { "heading": "Recibí las novedades", "heading_size": "h2" } },
        "paragraph": { "type": "paragraph", "settings": { "text": "<p>Nuevas ilustraciones, artistas invitados y pre-ventas antes que nadie.</p>" } },
        "email_form": { "type": "email_form", "settings": {} }
      },
      "block_order": ["heading", "paragraph", "email_form"],
      "settings": { "color_scheme": "scheme-4", "full_width": true, "padding_top": 60, "padding_bottom": 60 }
    }
  },
  "order": ["image_banner", "rich_text", "featured_collection", "collage", "multicolumn", "newsletter"]
}
